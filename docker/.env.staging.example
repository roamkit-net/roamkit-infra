# roamkit-infra — staging env template (Hetzner /opt/stacks/roamkit-net)
# Copy to .env on server. NEVER commit .env.
#
# Uses shared postgis (/opt/stacks/data) and infra-redis (/opt/stacks/redis, DB 4).
# Local dev: use docker/.env.example with docker-compose.dev.yml instead.

# --- Database (shared postgis — network: postgis, hostname: postgis) ---
POSTGRES_DB=roamkit
POSTGRES_USER=roamkit
POSTGRES_PASSWORD=change-me-local
POSTGRES_HOST=postgis
POSTGRES_PORT=5432

# --- Redis (shared infra-redis — network: hetzner_net, DB index 4) ---
REDIS_URL=redis://infra-redis:6379/4

# --- Django (roamkit-api) ---
DJANGO_SETTINGS_MODULE=config.settings.staging
DJANGO_SECRET_KEY=change-me-local-dev-only
DJANGO_ALLOWED_HOSTS=api.staging.roamkit.net,staging.roamkit.net,roamkit.net,www.roamkit.net,localhost,127.0.0.1
DJANGO_DEBUG=false

# --- Next.js (roamkit-web) ---
NEXT_PUBLIC_API_URL=https://api.staging.roamkit.net
NODE_ENV=production

# --- Integrations (staging .env on server) ---
# AIRALO_CLIENT_ID=
# AIRALO_CLIENT_SECRET=
# AIRALO_SANDBOX=true
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- GHCR image tags ---
API_IMAGE=ghcr.io/roamkit-net/roamkit-api:develop
WEB_IMAGE=ghcr.io/roamkit-net/roamkit-web:develop

# --- Deploy (GitHub Actions org secrets — not in server .env) ---
# STAGING_HOST=65.108.196.92
# STAGING_SSH_KEY=~/.ssh/id_ed25519 (set via gh secret set)
