# roamkit-infra — staging env template (Hetzner /opt/stacks/roamkit-net)
# Copy to .env on server. NEVER commit .env.
#
# Uses shared postgis (/opt/stacks/data) and infra-redis (/opt/stacks/redis, DB 4).
# Local dev: use docker/.env.example with docker-compose.dev.yml instead.

# --- Database (shared postgis — network: postgis, hostname: postgis) ---
POSTGRES_DB=roamkit
POSTGRES_USER=roamkit
POSTGRES_PASSWORD=change-me-local
POSTGRES_HOST=postgis
POSTGRES_PORT=5432

# --- Redis (shared infra-redis — network: hetzner_net, DB index 4) ---
REDIS_URL=redis://infra-redis:6379/4

# --- Django (roamkit-api) ---
DJANGO_SETTINGS_MODULE=config.settings.staging
DJANGO_SECRET_KEY=change-me-local-dev-only
DJANGO_ALLOWED_HOSTS=api.staging.roamkit.net,staging.roamkit.net,roamkit.net,www.roamkit.net,localhost,127.0.0.1
DJANGO_DEBUG=false

# --- Frontend URL (used in activation / password-reset emails) ---
FRONTEND_BASE_URL=https://staging.roamkit.net

# --- SMTP (mail.roamkit.net — password only in server .env / secrets) ---
EMAIL_HOST=mail.roamkit.net
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=info@roamkit.net
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@roamkit.net

# --- Next.js (roamkit-web) ---
NEXT_PUBLIC_API_URL=https://api.staging.roamkit.net
NODE_ENV=production

# --- Integrations (staging .env on server) ---
# AIRALO_CLIENT_ID=
# AIRALO_CLIENT_SECRET=
# AIRALO_SANDBOX=true
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Polygon USDT billing (ADR-010) — required for deposit UX on staging ---
# Set on the server .env, then recreate api/celery. Never commit real secrets.
BILLING_ENABLED=true
SUBSCRIPTIONS_ENABLED=false
# Keep false until Reown AppKit is confirmed on staging.
WALLETCONNECT_ENABLED=false
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# Operator-generated receive address (public). Private key lives only under
# /opt/stacks/roamkit-net/.secrets/ — never in git or this example file.
POLYGON_PLATFORM_WALLET=
POLYGON_USDT_CONTRACT=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
POLYGON_CHAIN_ID=137
POLYGON_MIN_CONFIRMATIONS=20
POLYGON_USDT_DECIMALS=6
POLYGON_RPC_TIMEOUT=10
POLYGON_RPC_RETRIES=3

# --- GHCR image tags ---
API_IMAGE=ghcr.io/roamkit-net/roamkit-api:develop
WEB_IMAGE=ghcr.io/roamkit-net/roamkit-web:develop

# --- Deploy (GitHub Actions org secrets — not in server .env) ---
# STAGING_HOST=65.108.196.92
# STAGING_SSH_KEY=~/.ssh/id_ed25519 (set via gh secret set)
