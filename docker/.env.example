# roamkit-infra — shared env template
# Copy to .env locally or on server. NEVER commit .env.

# --- Database (PostGIS) ---
POSTGRES_DB=roamkit
POSTGRES_USER=roamkit
POSTGRES_PASSWORD=change-me-local
POSTGRES_HOST=postgis
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Django (roamkit-api) ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-local-dev-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.staging.roamkit.net
DJANGO_DEBUG=true

# --- Next.js (roamkit-web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NODE_ENV=development

# --- Mail (dev/test — Mailpit) ---
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=noreply@roamkit.net
FRONTEND_BASE_URL=http://localhost:3000

# --- Integrations (staging .env on server) ---
# AIRALO_CLIENT_ID=
# AIRALO_CLIENT_SECRET=
# AIRALO_SANDBOX=true
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Polygon USDT billing (ADR-010) ---
# BILLING_ENABLED=true
# SUBSCRIPTIONS_ENABLED=false
# WALLETCONNECT_ENABLED=false
# POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# POLYGON_PLATFORM_WALLET=0x...
# POLYGON_USDT_CONTRACT=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
# POLYGON_CHAIN_ID=137
# POLYGON_MIN_CONFIRMATIONS=20
# POLYGON_USDT_DECIMALS=6
# POLYGON_RPC_TIMEOUT=10
# POLYGON_RPC_RETRIES=3

# --- GHCR image tags (staging on /opt/stacks/roamkit-net) ---
API_IMAGE=ghcr.io/roamkit-net/roamkit-api:develop
WEB_IMAGE=ghcr.io/roamkit-net/roamkit-web:develop

# --- Deploy (GitHub Actions org secrets — not in server .env) ---
# STAGING_HOST=65.108.196.92
# STAGING_SSH_KEY=~/.ssh/id_ed25519 (set via gh secret set)
