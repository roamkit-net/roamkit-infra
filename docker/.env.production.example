# roamkit-infra — production env template (Hetzner /opt/stacks/roamkit-production)
# Copy to .env on server. NEVER commit .env.
#
# Isolation vs staging (ADR 013):
#   POSTGRES_DB=roamkit_production  (not roamkit)
#   REDIS_URL=.../5                 (staging uses /4)
# Shared PostGIS/Redis hosts are OK; database name and Redis index must differ.
# No shared Docker volumes with /opt/stacks/roamkit-net/.

# --- Database (shared postgis — network: postgis, hostname: postgis) ---
POSTGRES_DB=roamkit_production
POSTGRES_USER=roamkit
POSTGRES_PASSWORD=change-me-production
POSTGRES_HOST=postgis
POSTGRES_PORT=5432

# --- Redis (shared infra-redis — network: hetzner_net, DB index 5) ---
REDIS_URL=redis://infra-redis:6379/5

# --- Django (roamkit-api) ---
# Real production settings module lands in api PR2 (C1). Until then staging
# module may be used only for dry-run stack bring-up — never for public cutover.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=change-me-production-50plus-chars
DJANGO_ALLOWED_HOSTS=api.roamkit.net,roamkit.net,www.roamkit.net,localhost,127.0.0.1
DJANGO_DEBUG=false

# --- Frontend URL (activation / password-reset emails) ---
FRONTEND_BASE_URL=https://roamkit.net

# --- SMTP (mail.roamkit.net — password only in server .env) ---
EMAIL_HOST=mail.roamkit.net
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=info@roamkit.net
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@roamkit.net

# --- Next.js (roamkit-web) — bake/build args must match at image build time ---
NEXT_PUBLIC_API_URL=https://api.roamkit.net
NODE_ENV=production

# --- Feature flags (ADR 013 cutover matrix) ---
BILLING_ENABLED=true
SUBSCRIPTIONS_ENABLED=false
# OFF at first cutover; re-enable after WalletConnect smoke on prod.
WALLETCONNECT_ENABLED=false

# --- Integrations (production .env on server ONLY) ---
# AIRALO_CLIENT_ID=
# AIRALO_CLIENT_SECRET=
# AIRALO_SANDBOX=false
# AIRALO_BASE_URL=https://partners-api.airalo.com

# --- Polygon USDT billing (ADR-010) — live wallet/RPC ---
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# Operator-generated receive address (public). Private key only under
# /opt/stacks/roamkit-production/.secrets/ — never in git.
POLYGON_PLATFORM_WALLET=
POLYGON_USDT_CONTRACT=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
POLYGON_CHAIN_ID=137
POLYGON_MIN_CONFIRMATIONS=20
POLYGON_USDT_DECIMALS=6
POLYGON_RPC_TIMEOUT=10
POLYGON_RPC_RETRIES=3

# --- Release metadata (consumed by GET /version — Gate C) ---
# Set by deploy CI / compose override; placeholders for local docs.
ROAMKIT_GIT_SHA=
ROAMKIT_BUILD_DATE=
ROAMKIT_IMAGE_TAG=
ROAMKIT_ENVIRONMENT=production

# --- Observability (Gate C) ---
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- GHCR image tags (prefer immutable SHA tags in real deploys) ---
API_IMAGE=ghcr.io/roamkit-net/roamkit-api:main
WEB_IMAGE=ghcr.io/roamkit-net/roamkit-web:main

# --- Deploy (GitHub Actions org secrets — not in server .env) ---
# PRODUCTION_HOST=65.108.196.92
# PRODUCTION_SSH_KEY=... (gh secret; may reuse STAGING_SSH_KEY on same host)
